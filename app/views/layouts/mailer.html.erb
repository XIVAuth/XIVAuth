<!DOCTYPE html>
<html lang="en">
<head>
  <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="color-scheme" content="light dark" />
  <meta name="supported-color-schemes" content="light dark" />
  <title>XIVAuth</title>
  <%= stylesheet_link_tag "mailer" %>
  <%= yield :email_markup %>
</head>
<body>
<div class="email-outer">
  <div class="email-container">

    <div class="email-header">
      <div class="email-header-overlay">
        <img class="email-logo" src="https://cdn.xivauth.net/static/images/email/header_logo.png" alt="XIVAuth">
      </div>
    </div>

    <div class="email-body">
      <%= yield %>
    </div>

    <div class="email-footer">
      <p>&copy;2023&ndash;<%= DateTime.current.year %> XIVAuth and KazWolfe. All rights reserved.</p>
      <p>
        <%= link_to "XIVAuth", root_url %>
        &bull;
        <a href="https://github.com/XIVAuth/XIVAuth">GitHub</a>
        &bull;
        <%= link_to "Discord", discord_url %>
      </p>
      <p style="margin-top: 10px; font-size: 12px;">
        This is a service communication from XIVAuth. If you were not expecting this email, you may ignore it.
      </p>
    </div>
  </div>
</div>
</body>
</html>
