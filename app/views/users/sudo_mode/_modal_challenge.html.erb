<%#
  Modal content for a "challenge first" flow: proves MFA, then posts to `url` so the gated action can render its real
  content into the same modal.
  Locals: title, url
%>
<%= form_with url: url, method: :post do %>
  <div class="modal-header">
    <h5 class="modal-title"><%= title %></h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
  </div>
  <div class="modal-body">
    <p>Confirm your identity with multifactor authentication to continue.</p>
    <%= render "users/sudo_mode/challenge_fields" %>
  </div>
  <div class="modal-footer">
    <button type="button" class="btn btn-secondary-outline" data-bs-dismiss="modal">Cancel</button>
    <button type="submit" class="btn btn-primary">Continue</button>
  </div>
<% end %>
