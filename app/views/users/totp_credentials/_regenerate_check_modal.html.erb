<%= form_with(model: @totp_credential, method: :post, url: regenerate_backup_user_totp_credential_path) do |f| %>
  <div class="modal-header">
    <h5 class="modal-title">Regenerate TOTP Backups</h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
  </div>
  <div class="modal-body">
    <p>
      To regenerate your backup codes, confirm your identity with multifactor authentication.
    </p>
    <%= render "users/sudo_mode/challenge_fields", auto_submit: false %>

  </div>
  <div class="modal-footer">
    <button type="button" class="btn btn-secondary-outline" data-bs-dismiss="modal">Cancel</button>
    <%= f.submit "Regenerate Authenticator", class: "btn btn-primary" %>
  </div>
<% end %>
