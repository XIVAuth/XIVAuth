<%= form_with(model: @totp_credential, method: :delete, url: user_totp_credential_path) do |f| %>
  <div class="modal-header">
    <h5 class="modal-title">Remove TOTP Credential</h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
  </div>
  <div class="modal-body">
    <p>
      To remove your authenticator app, confirm your identity with multifactor authentication. If you no longer have
      access to your authenticator, you may use a backup code.
    </p>
    <%= render "users/sudo_mode/challenge_fields", auto_submit: false %>

  </div>
  <div class="modal-footer">
    <button type="button" class="btn btn-secondary-outline" data-bs-dismiss="modal">Cancel</button>
    <%= f.submit "Remove Authenticator", class: "btn btn-danger" %>
  </div>
<% end %>
