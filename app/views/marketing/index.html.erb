<% set_meta_tags og: {
  description: "The last Lodestone code you'll ever need. XIVAuth is a free and open-source authentication provider for FINAL FANTASY XIV."
} %>

<% content_for :head_extensions do %>
  <%= stylesheet_link_tag "special/marketing" %>
<% end %>

<section id="hero" class="py-5 px-lg-4 header-img">
  <div class="container py-5">
    <div class="row align-items-center g-5">
      <div class="col-12 col-lg-8">
        <h1 class="display-4 fw-bold mb-3">Hello, XIVAuth.</h1>
        <p class="lead mb-4">
          XIVAuth is the last Lodestone code you'll ever need. Sign in to many services across the FINAL FANTASY XIV
          ecosystem with a single account.
        </p>
        <div class="d-flex flex-wrap gap-3">
          <% if user_signed_in? %>
            <%= link_to "Manage My Characters", character_registrations_path, class: "btn btn-primary btn-lg" %>
          <% else %>
            <%= link_to "Create your account", new_user_registration_path, class: "btn btn-primary btn-lg" %>
            <%= link_to "Log in", new_user_session_path, class: "btn btn-outline-secondary btn-lg" %>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</section>

<section id="users" class="py-5 px-lg-4">
  <div class="container">
    <div class="row mb-4">
      <div class="col-lg-8">
        <h2 class="h1 fw-bold">Made for players</h2>
        <p class="lead">Skip the Lodestone code dance and get started with that cool new app.</p>
      </div>
    </div>
    <div class="row g-4">
      <div class="col-12 col-md-6 col-lg-4">
        <div class="h-100 p-4 border rounded-3 marketing-card">
          <div class="icon-badge bg-primary-subtle text-primary">
            <i class="bi bi-lightning-charge-fill" aria-hidden="true"></i>
          </div>
          <h3 class="h5 mb-2 mt-3">Lightning Fast Registration</h3>
          <p>
            Instead of having to sign up for each app individually, XIVAuth takes care of all the registration steps for
            you.
          </p>
        </div>
      </div>
      <div class="col-12 col-md-6 col-lg-4">
        <div class="h-100 p-4 border rounded-3 marketing-card">
          <div class="icon-badge bg-success-subtle text-success">
            <i class="bi bi-lock-fill" aria-hidden="true"></i>
          </div>
          <h3 class="h5 mb-2 mt-3">2FA Everywhere</h3>
          <p>
            Apps never see your password, and optional MFA protects every app you sign in to.
          </p>
        </div>
      </div>
      <div class="col-12 col-md-6 col-lg-4">
        <div class="h-100 p-4 border rounded-3 marketing-card">
          <div class="icon-badge bg-info-subtle text-info">
            <i class="bi bi-incognito" aria-hidden="true"></i>
          </div>
          <h3 class="h5 mb-2 mt-3">Privacy Built In</h3>
          <p>
            Flexible data sharing rules mean you decide what information apps have access to. Share all your characters,
            just one, or none at all.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<section id="developers" class="py-5 px-lg-4 marketing-section">
  <div class="container">
    <div class="d-flex mb-4 align-items-center justify-content-between">
      <div class="flex-grow-1">
        <h2 class="h1 fw-bold font-monospace">
          <span class="user-select-none code-ps1"># </span>
          Built for devs<span class="cursor-blink user-select-none">_</span>
        </h2>
        <p class="lead mb-1 font-monospace">A turnkey authentication platform for FFXIV tools and websites.</p>
        <div class="small mt-2">
          <a href="https://github.com/XIVAuth/XIVAuth"><i class="bi bi-github me-1" aria-hidden="true"></i>Open
            source</a>
          and committed to transparency.
        </div>
      </div>
      <div class="d-none d-lg-block">
        <%= link_to developer_docs_path, class: "btn btn-primary", data: { "turbo-prefetch": false } do %>
          <i class="bi bi-book"></i> Developer Docs
        <% end %>
      </div>
    </div>
    <div class="row g-4">
      <div class="col-12 col-md-6">
        <div class="h-100 p-4 border rounded-3 marketing-card">
          <div class="icon-badge bg-primary-subtle text-primary">
            <i class="bi bi-plug-fill" aria-hidden="true"></i>
          </div>
          <h3 class="h5 mb-2 mt-3">Plug and Play API</h3>
          <p class="mb-0">
            Our handcrafted artisanal API is designed to make developers happy. Build for native, web, and whatever else
            you can imagine.
          </p>
        </div>
      </div>
      <div class="col-12 col-md-6">
        <div class="h-100 p-4 border rounded-3 marketing-card">
          <div class="icon-badge bg-info-subtle text-info">
            <i class="bi bi-person-bounding-box" aria-hidden="true"></i>
          </div>
          <h3 class="h5 mb-2 mt-3">Instant Onboarding</h3>
          <p class="mb-0">
            Transform onboarding from a multistep process into a simple SSO flow. Players skip the annoying account
            setup process.
          </p>
        </div>
      </div>
      <div class="col-12 col-md-6">
        <div class="h-100 p-4 border rounded-3 marketing-card">
          <div class="icon-badge bg-success-subtle text-success">
            <i class="bi bi-shield-lock-fill" aria-hidden="true"></i>
          </div>
          <h3 class="h5 mb-2 mt-3">Auth Without Headaches&trade;</h3>
          <p class="mb-0">
            Focus on building cool features rather than trying to figure out how to make logins work. We read
            the headache-inducing RFCs for you.
          </p>
        </div>
      </div>
      <div class="col-12 col-md-6">
        <div class="h-100 p-4 border rounded-3 marketing-card">
          <div class="icon-badge bg-warning-subtle text-warning">
            <i class="bi bi-chat-heart-fill" aria-hidden="true"></i>
          </div>
          <h3 class="h5 mb-2 mt-3">Support You Can Trust</h3>
          <p class="mb-0">
            Bug reports, integration assistance, and architecture advice are all a message away. We're dedicated to
            making the community more secure.
          </p>
        </div>
      </div>
    </div>
    <div class="mt-4">
      <small class="text-muted">By building apps with XIVAuth, you agree to our
        <%= link_to "Developer Agreement", legal_devagreement_path %>.</small>
    </div>
  </div>
</section>

<section class="py-5  px-lg-4">
  <div class="container">
    <div class="row g-4 align-items-center">
      <div class="col-12 col-lg-6">
        <h2 class="h1 fw-bold">
          Security is in our
          <img src="<%= image_path("marketing/dna_buff.png") %>" alt="DNA buff icon from P8S"
               class="marketing-dna-buff">DNA
        </h2>
        <p class="lead">
          XIVAuth is designed from the ground up to be secure. With a security engineer at the helm, we
          <s>pretend to</s> know what we're doing.
        </p>
        <div class="d-flex gap-3 flex-wrap mt-3">
          <%= link_to "Security practices", legal_security_path, class: "btn btn-outline-secondary" %>
          <%= link_to "Privacy policy", legal_privacy_path, class: "btn btn-outline-secondary" %>
          <%= link_to "Moderation policy", legal_moderation_path, class: "btn btn-outline-secondary" %>
        </div>
      </div>
      <div class="col-12 col-lg-6">
        <div class="p-4 border rounded-3 h-100 marketing-card">
          <ul class="list-unstyled mb-0">
            <li class="d-flex align-items-start mb-3">
              <i class="bi bi-check-circle-fill text-success me-3" aria-hidden="true"></i>
              <div>
                <strong>Battle-Tested Tooling</strong>
                <div class="text-muted">Security-related components are mature and well-known.</div>
              </div>
            </li>
            <li class="d-flex align-items-start mb-3">
              <i class="bi bi-check-circle-fill text-success me-3" aria-hidden="true"></i>
              <div>
                <strong>Secure by Design</strong>
                <div class="text-muted">Fail-fast and default-deny design at every level of the stack.</div>
              </div>
            </li>
            <li class="d-flex align-items-start mb-3">
              <i class="bi bi-check-circle-fill text-success me-3" aria-hidden="true"></i>
              <div>
                <strong>Surprise-Free Guarantee</strong>
                <div class="text-muted">Open-source code means everything is transparent and auditable.</div>
              </div>
            </li>
            <li class="d-flex align-items-start">
              <i class="bi bi-x-circle-fill text-danger me-3" aria-hidden="true"></i>
              <div>
                <strong>Strict No-Namazu Policies</strong>
                <div class="text-muted">Namazu discovered in the datacenter are forcibly removed, yes, yes.</div>
              </div>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>

<%= turbo_stream_from "marketing", id: "marketing-stream" %>
<section id="counters" class="py-5 marketing-section">
  <div class="container">
    <div class="row g-4 align-items-center">
      <div class="col-12 col-lg-6">
        <div class="row g-3">
          <div class="col-6">
            <div class="p-4 border rounded-3 marketing-card">
              <div class="display-5 fw-bold text-primary"><%= number_with_delimiter(@counts[:users]) %></div>
              <div class="fw-semibold">Registered <%= "Player".pluralize(@counts[:users]) %></div>
            </div>
          </div>
          <div class="col-6">
            <div class="p-4 border rounded-3 marketing-card">
              <div class="display-5 fw-bold text-success"><%= number_with_delimiter(@counts[:characters]) %></div>
              <div class="fw-semibold">Verified <%= "Character".pluralize(@counts[:characters]) %></div>
            </div>
          </div>
          <div class="col-6">
            <div class="p-4 border rounded-3 marketing-card">
              <div class="display-5 fw-bold text-info"><%= number_with_delimiter(@counts[:applications]) %></div>
              <div class="fw-semibold">Connected <%= "App".pluralize(@counts[:applications]) %></div>
            </div>
          </div>
          <div class="col-6">
            <%= render "marketing/headpats_card", count: @counts[:headpats] %>
          </div>
        </div>
      </div>
      <div class="col-12 col-lg-6">
        <h2 class="h1 fw-bold">Numbers say it all</h2>
        <p class="lead">
          Thousands of users and characters later, we're still going strong. XIVAuth is proud to provide trusted
          identity services to the FINAL FANTASY XIV community.
        </p>
        <%= button_to "Pet the Miqo'te!", marketing_cat_path, class: "btn btn-warning mt-2" %>
      </div>
    </div>
  </div>
</section>
