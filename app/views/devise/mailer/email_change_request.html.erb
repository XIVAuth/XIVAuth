<% email_confirm_action name: "Confirm New Email",
                         url: user_one_click_confirmation_url(confirmation_token: @token),
                         description: "Confirm this email address for your XIVAuth account." %>
<h1>Hi there!</h1>
<p>
  Someone (hopefully you) requested to change the email address associated with an XIVAuth account to
  <code><%= @email %></code> (this address). To confirm the change, simply click the button below. If you did not
  request this change or weren't expecting this email, you may safely disregard this email.
</p>

<div class="btn-cta-wrap">
  <%= link_to "Confirm New Email", user_confirmation_url(confirmation_token: @token), class: "btn bg-primary",
              target: "_blank" %>
</div>

<p>Thanks,<br>XIVAuth User Management Service</p>

<hr class="divider">

<p class="fine-print">
  If you're having trouble with the button above, copy and paste this URL into your browser:<br>
  <span style="font-family: monospace;"><%= user_confirmation_url(confirmation_token: @token) %></span>
</p>
